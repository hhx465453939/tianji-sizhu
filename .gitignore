系统及.claude迁移模板.7z

# ── OS ─────────────────────────────────────
.DS_Store
Thumbs.db

# ── Database ───────────────────────────────
*.db

# ── Virtualized toolchain (MUST stay inside project, never commit) ──
# See AGENTS.md → 虚拟化与隔离部署治理
/.android/
/.virtual/
/.venv/
/.toolchain/
/.cache/
/.tmp/

# ── Android build outputs (source in android/ IS committed) ──
/android/.gradle/
/android/local.properties
/android/build/
/android/app/build/
/android/app/release/
/android/capacitor-cordova-android-plugins/
/frontend/android/.gradle/
/frontend/android/local.properties
/frontend/android/build/
/frontend/android/app/build/
/frontend/android/app/release/
/frontend/android/capacitor-cordova-android-plugins/

# ── Stray artifacts (pending manual removal) ──
